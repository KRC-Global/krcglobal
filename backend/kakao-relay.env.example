# 항상 켜진 Mac에서 접근 가능한 KRC Global 사이트 주소
KRC_API_BASE_URL=https://your-krcglobal.example.com

# 서버의 WORKER_SECRET과 동일한 값 (이 파일은 절대 Git에 커밋하지 않음)
WORKER_SECRET=replace-with-worker-secret

# Mac 카카오톡 채팅 목록에 표시되는 정확한 1:1 친구방 이름
KAKAO_ROOM_NAME=친구 이름

# 선택 설정
KMSG_BIN=/opt/homebrew/bin/kmsg
KAKAO_RELAY_POLL_SECONDS=30
KAKAO_RELAY_HTTP_TIMEOUT=30
KAKAO_RELAY_WORKER_ID=krc-kakao-mac

# 최초 점검 때 true, 실제 자동 발송을 시작할 때 false로 변경
KAKAO_RELAY_DRY_RUN=true
